<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Existing macros, properties, links, and joints (unchanged) -->
    <xacro:property name="pi" value="3.14159265359"/>
    <!-- ... other properties ... -->

    <link name="dummy_base"></link>
    <joint name="dummy_base_to_base_link" type="fixed">
        <parent link="dummy_base"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <!-- ... other links and joints ... -->

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.122 0 0.212" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 -0.05"/>
            <geometry>
                <cylinder radius="0.01" length="0.1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="laser" type="gpu_lidar">
            <always_on>true</always_on>
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                </range>
            </lidar>
            <topic>/my_robot/scan</topic> <!-- Updated to match expected namespace -->
            <get_frame_id>laser_frame</get_frame_id>
            <plugin filename="gz-sim-lidar-system" name="gz::sim::systems::Lidar">
                <ros>
                    <namespace>/my_robot</namespace>
                </ros>
                <frame_id>laser_frame</frame_id>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Existing ros2_control and gazebo sections (unchanged) -->
    <ros2_control name="GazeboSimSystem" type="system">...</ros2_control>
    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">...</plugin>
    </gazebo>

</robot>