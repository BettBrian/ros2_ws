  <material name="silver">
    <color rgba="0.80000 0.80000 0.80000 1.00000"/>
  </material>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Hip Joints (4 actuated) -->
    <joint name="blhipmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="brhipmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="flhipmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="frhipmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Upper Leg Joints (4 actuated) -->
    <joint name="blupperlegmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="brupperlegmotoplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="flupperlegmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="frupperlegmotorplate_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Part1/Knee Joints (4 actuated - these control the mimicked joints) -->
    <joint name="blpart1_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="brpart1_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="flpart1_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="frpart1_link_joint">
      <command_interface name="position">
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
  <gazebo reference="blhipmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="blupperlegmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="blpart1_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="brhipmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="brupperlegmotoplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="brpart1_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>

  <gazebo reference="flhipmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="flupperlegmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="flpart1_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>

  <gazebo reference="frhipmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="frupperlegmotorplate_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo reference="frpart1_link_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <kp>1000000.0</kp> <kd>100.0</kd>
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find project)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/lidar</topic>
      <frame_id>lidar_link</frame_id>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>64</samples>       
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="Camera_link_optical">
    <sensor name="Cam" type="camera">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <frame_id>Camera_link_optical</frame_id>
    <gz_frame_id>Camera_link_optical</gz_frame_id>
    <topic>camera/image_raw</topic>
      <camera>
      <hfov>1.57080</hfov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>      
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>